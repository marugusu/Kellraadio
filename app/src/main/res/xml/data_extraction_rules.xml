<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Välistame andmebaasi pilve varundusest -->
        <exclude domain="database" path="raadio_database"/>
        <exclude domain="database" path="raadio_database-shm"/>
        <exclude domain="database" path="raadio_database-wal"/>
    </cloud-backup>
    <device-transfer>
        <!-- Välistame andmebaasi ka seadmete vahelisest otseülekandest privaatsuse huvides -->
        <exclude domain="database" path="raadio_database"/>
        <exclude domain="database" path="raadio_database-shm"/>
        <exclude domain="database" path="raadio_database-wal"/>
    </device-transfer>
</data-extraction-rules>